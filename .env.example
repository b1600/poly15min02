# Copy to .env and fill in. Every value has a sane default in config.py;
# nothing below is required for Phase 0/1 (read-only public data recording).

# POLY15M_ENVIRONMENT=development
# POLY15M_LOG_LEVEL=INFO
# POLY15M_DB_PATH=var/poly15m.db

# --- optional: mirror all log output to a Telegram chat ---
# both must be set to enable forwarding
# POLY15M_TELEGRAM_BOT_TOKEN=
# POLY15M_TELEGRAM_CHAT_ID=

# --- only needed from Phase 4 onward (live execution) ---
# POLY15M_POLYMARKET_PRIVATE_KEY=
# POLY15M_POLYMARKET_API_KEY=
# POLY15M_POLYMARKET_API_SECRET=
# POLY15M_POLYMARKET_API_PASSPHRASE=
# POLY15M_POLYMARKET_FUNDER_ADDRESS=
# POLY15M_POLYMARKET_SIGNATURE_TYPE=1
